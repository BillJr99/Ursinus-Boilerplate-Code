# Link text and address by label kind: display-only blocks open in Explain mode, sessions in
# Simulate mode, everything else in the default (Run) view (sections 4, 21 to 23).
LINK_KIND = {"show": ("Explain this example", "?mode=explain"), "session": ("Simulate this session", "?mode=simulate")}


# Fence languages that are not code to explain (prose, output, diagrams), for label --show.
NOT_CODE = {"", "text", "txt", "plaintext", "none", "output", "mermaid", "math", "latex", "tex", "md", "markdown",
            "csv", "tsv", "log", "ascii", "diagram"}


def show_candidate(b):
    """A block worth a display-only label: a code language, and at least three non-blank lines."""
    return (b.get("lang") or "").lower() not in NOT_CODE and len([l for l in b["code"].split("\n") if l.strip()]) >= 3


def block_link(info, b, vid):
    """The Visualize link for a block: Markdown, or HTML for code embedded in a <script> (models are HTML)."""
    text, q = LINK_KIND.get((b.get("label") or {}).get("viz"), ("Visualize this example", ""))
    if b.get("html"):
        return f'<a href="{info["url"]}/viz/{q}#{vid}">{text}</a> {LINK_MARK}'
    return link_line(info, vid, text, q)


def link_line(info, vid, text="Visualize this example", q=""):
    return f"[{text}]({info['url']}/viz/{q}#{vid}) {LINK_MARK}"


def link_slot(lines, b):
    """Where a block's Visualize link goes: the line after its closing fence, past any LiaScript
    @-macro lines (@LIA.eval ...) and <script> lines that belong to the block."""
    after = b["end"] + 1
    if b.get("html"):
        return after   # an embedded <script> block: right after its ]]></script> line
    while after < len(lines):
        t = lines[after].strip()
        if t.startswith("@"):
            after += 1
        elif t.startswith("<script"):
            # skip the whole script element, which may span several lines
            while after < len(lines) and "</script>" not in lines[after]:
                after += 1
            after += 1
        else:
            break
    return after


def cmd_links(a):
    """Add the missing "Visualize this example" line under every labeled block (section 5, links)."""
    root = repo_root()
    info = site_info(root)
    missing = 0
    for page in pages(root, a.page):
        bs, lines = blocks(root, page)
        # a block is linked when its own link is anywhere on the page (it may sit a line lower)
        linked = {vid for l in lines if LINK_MARK in l for vid in re.findall(r"/viz/(?:\?[^#)\"]*)?#([\w.-]+)[)\"]", l)}
        todo = [b for b in bs if b["label"] and b["label"].get("id") and b["label"]["id"] not in linked]
        if not todo:
            continue
        missing += len(todo)
        for b in todo:
            print(f"  {page}:{b['start'] + 1}  {b['label']['id']}")
        if a.check:
            continue
        for b in sorted(todo, key=lambda b: -b["start"]):   # bottom-up keeps line numbers valid
            lines.insert(link_slot(lines, b), b.get("indent", "") + block_link(info, b, b["label"]["id"]))
        write_page(root, page, lines)
    verb = "missing" if a.check else "added"
    missing += NB.add_links(root, info, pages(root, a.page), LINK_MARK, check=a.check)  # notebook examples
    print(f"{missing} link(s) {verb}")
    return 1 if (a.check and missing) else 0


def report_failures(a, cands, keep, traces):
    """label --try --report FILE: append the candidates that did not run cleanly, with what they
    printed and their error, as JSON lines (for triage; section 5, label)."""
    if not getattr(a, "report", None):
        return
    kept = {b["label"]["id"] for b in keep}
    with open(a.report, "a", encoding="utf-8") as f:
        for b in cands:
            vid = b["label"]["id"]
            if vid in kept:
                continue
            t = traces.get(vid, {})
            f.write(json.dumps({"id": vid, "page": b["page"], "line": b["start"] + 1, "viz": b["label"].get("viz"),
                                "error": (t.get("error") or "")[:400], "stdout": (t.get("stdout") or "")[-400:],
                                "steps": len(t.get("steps") or []), "figures": len(t.get("figures") or [])}) + "\n")


def label_notebooks(a, root, info, docker):
    """label --notebooks: list the notebook cells that print or draw in viz/notebooks.json (with --try,
    only those that run cleanly after the earlier cells), then optionally add the page links."""
    idx = NB.load_index(root)
    listed = {n["file"]: n for n in idx.get("notebooks", [])}
    have = {e["id"] for n in listed.values() for e in n.get("examples", [])}
    cands = []
    for nb in NB.find(root):
        if a.page and os.path.normpath(a.page) != os.path.normpath(nb):
            continue
        cells = NB.code_cells(root, nb)
        done = {e["cell"] for e in listed.get(nb, {}).get("examples", [])}
        for k, code in enumerate(cells, 1):
            v = NB.suggest(code)
            vid = f"{info['course']}-nb-{slug(nb)}-{k}"
            if k in done or not v or vid in have or (a.viz and v != a.viz):
                continue
            lab = {"id": vid, "viz": v, "timeout": NB.TIMEOUT}
            if NB.notebook_runner(cells):
                lab["runner"] = NB.notebook_runner(cells)
            cands.append(NB.block(nb, cells, k, lab))
    keep = cands
    if docker and cands:
        src = tempfile.mkdtemp(prefix="code-viz-try-")
        try:
            traces = run_jobs([job_for(b, root, src) for b in cands], docker, src)
        finally:
            retire_path(src)
        def good(b):
            t = traces.get(b["label"]["id"], {})
            return not t.get("error") and bool((t.get("stdout") or "").strip() or t.get("figures") or t.get("steps"))
        keep = [b for b in cands if good(b)]
        report_failures(a, cands, keep, traces)
    for b in keep:
        n = listed.setdefault(b["notebook"], {"file": b["notebook"], "examples": []})
        n["examples"].append({k: v for k, v in {"id": b["label"]["id"], "cell": b["cell"], "viz": b["label"]["viz"],
                                                 "runner": b["label"].get("runner"), "timeout": b["label"].get("timeout")}.items() if v})
    idx["notebooks"] = list(listed.values())
    NB.save_index(root, idx)
    per = {}
    for b in keep:
        per[b["notebook"]] = per.get(b["notebook"], 0) + 1
    for nb, k in sorted(per.items()):
        print(f"{nb}: labeled {k} cell(s)")
    print(f"labeled {len(keep)} of {len(cands)} notebook candidate(s)")
    if a.links:
        NB.add_links(root, info, pages(root), LINK_MARK)
    return 0


