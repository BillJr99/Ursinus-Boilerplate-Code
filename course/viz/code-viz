def site_info(root):
    url, base = "", ""
    cfg = os.path.join(root, "_config.yml")
    if os.path.exists(cfg):
        for line in open(cfg, encoding="utf-8", errors="replace"):
            m = re.match(r"^\s*url\s*:\s*\"?([^\"#\s]+)", line)
            if m:
                url = m.group(1).rstrip("/")
            m = re.match(r"^\s*baseurl\s*:\s*\"?([^\"#\s]*)", line)
            if m:
                base = m.group(1).rstrip("/")
    name = os.path.basename(root)
    m = re.search(r"(CS\d+|CIE\d+)", name, re.I)
    course = m.group(1).lower() if m else re.sub(r"\W", "", name.lower())[:8]
    # GitHub Pages paths are case-sensitive: lower-case only the host
    return {"url": (url.lower() + base) if url else "", "course": course}


def pages(root, only=None):
    out = []
    for sub in ("_pages/Activities", "_pages/Tutorials"):
        d = os.path.join(root, sub)
        for dp, _, fn in os.walk(d):
