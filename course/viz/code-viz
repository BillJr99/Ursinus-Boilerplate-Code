def submodule_dirs(root):
    """Paths of the repo's submodules (from .gitmodules), so their pages are never read or edited."""
    try:
        txt = open(os.path.join(root, ".gitmodules"), encoding="utf-8").read()
    except OSError:
        return set()
    return {os.path.normpath(m) for m in re.findall(r"^\s*path\s*=\s*(.+?)\s*$", txt, re.M)}


def pages(root, only=None):
    """Every Markdown page under _pages (Activities, Tutorials, Labs, Modules, Assignments, Projects and
    notes pages), except submodules such as _pages/Exercises (section 4, Pages)."""
    out = []
    subs = submodule_dirs(root)
    base = os.path.join(root, "_pages")
    for dp, dn, fn in os.walk(base):
        rel = os.path.relpath(dp, root)
        dn[:] = sorted(d for d in dn if os.path.normpath(os.path.join(rel, d)) not in subs and not d.startswith("."))
        for f in sorted(fn):
            if f.endswith(".md"):
                p = os.path.relpath(os.path.join(dp, f), root)
                if only is None or os.path.normpath(p) == os.path.normpath(only):
                    out.append(p)
    return sorted(out)


def slug(path):
    return re.sub(r"[^a-z0-9]+", "-", os.path.splitext(os.path.basename(path))[0].lower()).strip("-")


# ---- blocks --------------------------------------------------------------------------------------
def parse_label(text):
    out = {}
    for m in re.finditer(r"(\w+)(?:=(\"[^\"]*\"|\S+))?", text):
        v = m.group(2)
        out[m.group(1)] = (v[1:-1] if v and v.startswith('"') else v) if v is not None else True
    return out


def blocks(root, page):
    """Fenced blocks of a page: (start line index, end index, lang, code, label, indent, heading).

    A fence may be indented up to 12 spaces (a code block inside a list item); its closing fence must
    have the same indent, and the code is returned with that indent removed. `heading` is the text of
    the nearest heading above the block (used to skip solution blocks)."""
    lines = open(os.path.join(root, page), encoding="utf-8", errors="replace").read().split("\n")
    out, i, heading = [], 0, ""
    while i < len(lines):
        m = FENCE.match(lines[i])
        if m:
            ind, tok, lang = m.group(1), m.group(2), (m.group(3) or "").lower()
            fence = tok[0] * len(tok)
            j = i + 1
            if not ind:     # column 0: exactly as before (the closer starts the line)
                while j < len(lines) and not lines[j].startswith(fence):
                    j += 1
            else:           # indented: a closer indented within three spaces of the opener
                while j < len(lines) and not (lines[j].lstrip(" ").startswith(fence)
                                              and abs((len(lines[j]) - len(lines[j].lstrip(" "))) - len(ind)) <= 3):
                    j += 1
            label = None
            k = i - 1
            if k >= 0 and LABEL.match(lines[k]):
                label = parse_label(LABEL.match(lines[k]).group(1))
            body = [l[len(ind):] if l.startswith(ind) else l.lstrip(" ") for l in lines[i + 1:j]]
            out.append({"start": i, "end": j, "lang": LANG_ALIASES.get(lang, lang), "code": "\n".join(body),
                        "label": label, "page": page, "indent": ind, "heading": heading})
            i = j + 1
            continue
        h = HEADING.match(lines[i])
        if h:
            heading = h.group(1)
        i += 1
    # code embedded as <script type="syntaxhighlighter"> (activity models, older pages): langs.py
    out = sorted(out + LX.script_blocks(lines, page, LABEL, parse_label, HEADING), key=lambda b: b["start"])
    sol = solution_lines(lines)
    for b in out:
        b["in_solution"] = sol[b["start"]] if b["start"] < len(sol) else False
    return out, lines


def solution_lines(lines):
    """For each line: is it inside a <details> whose <summary> names a solution or answer key ("Click
    to reveal a solution to Exercise 3")? Such blocks are never labeled (section 4)."""
    out, stack, summary = [], [], None     # summary: text of a <summary> still open on earlier lines
    for line in lines:
        low = line.lower()
        for _ in range(low.count("<details")):
            stack.append(False)
        m = re.search(r"<summary[^>]*>(.*?)(</summary>|$)", line, re.I)
        if m:
            summary = m.group(1)
            if m.group(2):
                summary_done = True
            else:
                summary_done = False
        elif summary is not None:
            summary += " " + line.split("</summary>")[0]
            summary_done = "</summary>" in low
        if summary is not None and stack:
            stack[-1] = stack[-1] or bool(SOLUTION.search(re.sub(r"<[^>]+>", "", summary)))
        if summary is not None and summary_done:
            summary = None
        out.append(any(stack))
        for _ in range(low.count("</details>")):
            if stack:
                stack.pop()
    return out


def looks_lambda(code):
    sys.path.insert(0, TRACERS)
    import lambdatrace
    w = lambdatrace.worked_term(code)
    if w:
        try:
            lambdatrace.parse(lambdatrace.tokens(w))
            return True
        except SyntaxError:
            return False
    ls = [l.strip() for l in code.splitlines() if l.strip() and not l.strip().startswith(("#", "--"))]
    if not ls or not any("λ" in l or re.search(r"\\[a-z]\s*\.", l) for l in ls):
        return False
    if not all(re.fullmatch(r"([A-Za-z_][A-Za-z0-9_']*\s*=\s*)?[λ\\A-Za-z0-9_'.()\s]+", l) for l in ls):
        return False
    # an example to reduce needs at least one expression line, not only definitions
    return any(not re.match(r"^[A-Za-z_][A-Za-z0-9_']*\s*=", l) for l in ls)


_BUILTINS = set(dir(__import__("builtins")))


def py_names(code):
    """(names a Python block uses but does not define, names it defines), or None if it does not parse."""
    import ast
    try:
        tree = ast.parse(code)
    except SyntaxError:
        return None
    defined, used = set(), set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Name):
            (defined if isinstance(node.ctx, (ast.Store, ast.Del)) else used).add(node.id)
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            defined.add(node.name)
        elif isinstance(node, (ast.Import, ast.ImportFrom)):
            defined |= {(x.asname or x.name).split(".")[0] for x in node.names}
        elif isinstance(node, ast.arg):
            defined.add(node.arg)
        elif isinstance(node, ast.ExceptHandler) and node.name:
            defined.add(node.name)
    return used - defined - _BUILTINS, defined


def setup_deps(b, earlier):
    """The earlier Python blocks (in page order) that define the names block b uses but does not
    define itself, for a setup= field; [] when it needs none; None when some name is defined nowhere
    earlier. earlier: the Python blocks above b on the same page, top first."""
    names = py_names(b["code"])
    if names is None:
        return None
    missing = set(names[0])
    if not missing:
        return []
    deps = []
    for e in reversed(earlier):
        en = py_names(e["code"])
        if not en:
            continue
        got = missing & en[1]
        if got:
            deps.insert(0, e)
            missing -= got
            missing |= en[0]      # what that block needs in turn
        if not missing:
            return deps
    return None


def setup_chain(ids, lookup, seen=None):
    """Resolve setup= ids (and their own setup= fields, first) into an ordered list of blocks."""
    seen = set() if seen is None else seen
    out = []
    for i in ids:
        if i in seen:
            continue
        seen.add(i)
        b = lookup.get(i)
        if b is None:
            raise ValueError(f"setup={i}: no labeled block with that id")
        sub = [x for x in (b["label"].get("setup") or "").split(",") if x]
        out += setup_chain(sub, lookup, seen) + [b]
    return out


_LOOKUP = {}


def block_lookup(root):
    """id -> labeled block for the whole site (cached per repo)."""
    if root not in _LOOKUP:
        _LOOKUP[root] = {b["label"]["id"]: b for b in all_blocks(root) if b.get("label")}
    return _LOOKUP[root]


MODULE_HEAD = re.compile(r"^#\s*([A-Za-z_][\w]*\.py)(\s*\(continued\))?\s*$")


def interp_files(root, page):
    """interp=: the Python interpreter a page builds, as {file name: code}, in page order.

    A Python block whose first line is `# name.py` starts that file (again, if it already began);
    `# name.py (continued)` appends to it. Blocks without such a heading (demos, tests) are not part of the interpreter."""
    files = {}
    for b in blocks(root, page)[0]:
        if b["lang"] != "python":
            continue
        first = b["code"].lstrip("\n").split("\n", 1)[0].strip()
        m = MODULE_HEAD.match(first)
        if m and not m.group(1).startswith("test_"):
            if m.group(2):   # (continued): append to the file
                files.setdefault(m.group(1), []).append(b["code"])
            else:            # a bare heading starts the file again (a later block rewriting a module)
                files[m.group(1)] = [b["code"]]
    return {f: "\n\n".join(parts) + "\n" for f, parts in files.items()}


def interp_page(lab, b):
    """The page interp= names: `page` (or a bare `interp`) is the example's own page."""
    v = lab.get("interp")
    return b["page"] if v in (True, "page") else v


def suggest(b):
    """A suggested label for an unlabeled block, or None when it is not a runnable example.
    langs.suggest adds SQL, Java, JavaScript, MIPS and VHDL, and the C fork/thread rule. A block under a
    Solution / Answer key heading or in a "reveal a solution" <details> is never suggested, in any
    language (section 4)."""
    if SOLUTION.search(b.get("heading") or "") or b.get("in_solution"):
        return None
    return LX.suggest(b, _suggest_base(b))


def _suggest_base(b):
    code, lang = b["code"], b["lang"]
    n = len([l for l in code.splitlines() if l.strip()])
    if lang == "python" and n >= 3:
        import ast
        try:
            tree = ast.parse(code)
        except SyntaxError:
            return None
        if "input(" in code or re.search(r"^\s*\.\.\.\s*$", code, re.M) or "# ..." in code:
            return None
        mods = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                mods |= {a.name.split(".")[0] for a in node.names}
            elif isinstance(node, ast.ImportFrom) and node.module:
                mods.add(node.module.split(".")[0])
        if AGENT_HINTS.search(code) and mods <= STDLIB | {"ollama", "httpx", "openai"}:
            return {"viz": "agent", "lang": "python", "record": True}
        prints = re.search(r"\bprint\s*\(", code)
        draws = bool(mods & ({"matplotlib", "seaborn"} | GRAPHICS)) or re.search(r"\bplt\.", code)
        if mods & ML and mods <= STDLIB | EXTRA | ML:
            # PyTorch: output and figures only, in the CPU-only python-ml runner, with more time
            return {"viz": "plain", "lang": "python", "runner": "python-ml", "timeout": "120"} if (prints or draws) else None
        if not mods <= STDLIB | EXTRA:
            return None
        if draws:
            return {"viz": "plain", "lang": "python"}   # figures (section 7); stepping would draw Figure objects
        if not prints:
            return None
        return {"viz": "env", "lang": "python"}
    if lang == "scheme" and n >= 1 and code.count("(") == code.count(")"):
        return {"viz": "env", "lang": "scheme"}
    if lang in ("", "text", "none", "lambda") and looks_lambda(code):
        return {"viz": "lambda", "lang": "lambda"}
    if lang in ("c", "cpp") and "main(" in code and "#include" in code:
        return {"viz": "c", "lang": lang}
    if lang == "haskell" and re.search(r"^main\s*(::|=)", code, re.M):
        return {"viz": "plain", "lang": "haskell"}
    if lang == "prolog" and "?-" in code:
        return {"viz": "plain", "lang": "prolog"}
    if lang == "ocaml" and re.search(r"print_|Printf", code):
        return {"viz": "plain", "lang": "ocaml"}
    if lang == "mini" and n >= 1:
        return {"viz": "plain", "lang": "mini"}
    if lang == "shell" and n >= 1:
        safe = re.compile(r"^\s*(\$\s*)?(echo|printf|ls|cat|grep|sed|awk|wc|sort|uniq|head|tail|cut|tr|seq|expr|python3 -c|jq|date|pwd|true|false)\b")
        cmds = [l for l in code.splitlines() if l.strip() and not l.strip().startswith("#")]
        if cmds and all(safe.match(l) for l in cmds) and "<<" not in code:
            return {"viz": "cast", "lang": "shell"}
    return None


# ---- containers ----------------------------------------------------------------------------------
class Docker:
    def __init__(self, host=None, sudo=None, keep=False, ollama_network=None):
        self.host = host or os.environ.get("CODE_VIZ_HOST") or None
        self.sudo = sudo if sudo is not None else bool(self.host)
        self.keep = keep
        self.ollama_network = ollama_network
        self.built = {}
        self.staged = []        # staging folders on the Docker host, moved to ~/scratch at cleanup
        self.mine = set()       # images this run built (cleanup removes only these)

    def _cmd(self, args):
        d = (["sudo", "-n", "docker"] if self.sudo else ["docker"]) + args
        if self.host:
            return ["ssh", "-o", "BatchMode=yes", self.host, " ".join(shlex.quote(x) for x in d)]
        return d

    def sh(self, args, timeout=3600, check=True):
        r = subprocess.run(self._cmd(args), capture_output=True, text=True, timeout=timeout)
        if check and r.returncode != 0:
            raise RuntimeError(f"docker {' '.join(args[:2])} failed: {r.stderr[-800:]}")
        return r

    def remote_dir(self, local, name):
        """Copy a folder to the Docker host (no-op locally) and return its path there."""
        if not self.host:
            return local
        # A fresh folder for every copy, so no rsync --delete is needed (that asks first under Bill's
        # 2026-11-14 rule); the folders move to ~/scratch/code-viz on the host at cleanup.
        self._n = getattr(self, "_n", 0) + 1
        rdir = f"Documents/code-viz-staging/{name}-{os.getpid()}-{int(time.time())}-{self._n}"
        subprocess.run(["ssh", "-o", "BatchMode=yes", self.host, f"mkdir -p {shlex.quote(rdir)}"], check=True)
        subprocess.run(["rsync", "-a", local.rstrip("/") + "/", f"{self.host}:{rdir}/"], check=True)
        home = subprocess.run(["ssh", "-o", "BatchMode=yes", self.host, "echo $HOME"], capture_output=True, text=True).stdout.strip()
        self.staged.append(f"{home}/{rdir}")
        return f"{home}/{rdir}"

    def fetch_dir(self, remote, local):
        if self.host:
            subprocess.run(["rsync", "-a", f"{self.host}:{remote}/", local.rstrip("/") + "/"], check=True)

    def retire(self, remote):
        """Move a staging folder to ~/scratch on the Docker host (never deleted there)."""
        if self.host:
            subprocess.run(["ssh", "-o", "BatchMode=yes", self.host,
                            f"mkdir -p ~/scratch/code-viz && mv {shlex.quote(remote)} ~/scratch/code-viz/ 2>/dev/null || true"])

    def image(self, runner):
        # Checked before every batch, not cached: another code-viz run on the same host (two slots
        # run at once) may remove an image it built while this run is between batches; then it is
        # built again here instead of the batch failing with "Unable to find image" (section 15).
        df = os.path.join(RUNNERS, runner, "Dockerfile")
        tag = f"code-viz-{runner}:" + hashlib.sha256(open(df, "rb").read()).hexdigest()[:12]
        if self.sh(["image", "inspect", tag], check=False).returncode != 0:
            self.mine.add(tag)      # built by this run: the only images cleanup removes
            ctx = self.remote_dir(os.path.join(RUNNERS, runner), f"runner-{runner}")
            print(f"  building runner image {tag} ...", flush=True)
            # --network host: on minipc, downloads during docker build time out on the default bridge
            # (found with the agents image, 2026-11-14). Only the build uses it; runs stay --network none.
            self.sh(["build", "-q", "--network", "host", "--label", "code-viz=1", "-t", tag, ctx], timeout=3600)
        self.built[runner] = tag
        return tag

    def check_ollama(self):
        """Agent examples reach Ollama at http://ollama:11434 (or $OLLAMA_HOST), so the network given
        with --ollama-network needs a container answering to the name "ollama". Without it a
        recording "succeeds" with only connection errors, so warn before running."""
        if not self.ollama_network or os.environ.get("OLLAMA_HOST"):
            return True
        r = self.sh(["network", "inspect", self.ollama_network, "--format",
                     "{{range .Containers}}{{.Name}} {{end}}"], check=False)
        names = r.stdout.split() if r.returncode == 0 else []
        for n in names:
            q = self.sh(["inspect", n, "--format",
                         "{{range $k, $v := .NetworkSettings.Networks}}{{$k}}={{join $v.Aliases \",\"}};{{end}}"], check=False)
            if n == "ollama" or f"{self.ollama_network}=" in q.stdout and "ollama" in q.stdout.split(f"{self.ollama_network}=")[1].split(";")[0].split(","):
                return True
        print(f"  WARNING: no container named or aliased 'ollama' on network {self.ollama_network}; "
              "start Ollama with --network-alias ollama (see code-viz --help), or set OLLAMA_HOST", flush=True)
        return False

    def run_batch(self, runner, jobs, src_dir):
        """Run a batch of jobs in one container; returns {id: trace}."""
        work = tempfile.mkdtemp(prefix=f"code-viz-{runner}-")
        shutil.copytree(src_dir, os.path.join(work, "src"), dirs_exist_ok=True)
        json.dump(jobs, open(os.path.join(work, "jobs.json"), "w"))
        tag = self.image(runner)
        if runner == "agents":
            self.check_ollama()
        name = f"cviz-{runner}-{int(time.time())}-{os.getpid()}"
        rwork = self.remote_dir(work, name)
        rtr = self.remote_dir(TRACERS, "tracers")
        net = ["--network", self.ollama_network] if runner == "agents" and self.ollama_network else ["--network", "none"]
        env = ["-e", f"OLLAMA_HOST={os.environ.get('OLLAMA_HOST', 'http://ollama:11434')}"] if runner == "agents" else []
        total = 60 + sum(j.get("timeout", 15) for j in jobs)
        for attempt in range(3):
            r = self.sh(["run", "--rm", "--name", f"{name}-{attempt}" if attempt else name, *net, *env, "--cpus", "1",
                         "--memory", "1g", "--pids-limit", "256",
                         "-v", f"{rtr}:/viz/tracers:ro", "-v", f"{rwork}:/work", tag,
                         "timeout", str(total), "python3", "/viz/tracers/driver.py"], timeout=total + 120, check=False)
            # Another code-viz run on this host may remove a shared runner image between our check
            # and this run (two slots at once): build it again and rerun the batch (section 15).
            if r.returncode == 0 or "Unable to find image" not in (r.stderr or ""):
                break
            print(f"  runner image {tag} was removed by another run; building it again", flush=True)
            tag = self.image(runner)
        self.fetch_dir(rwork, work)
        self.retire(rwork)
        out = {}
        for j in jobs:
            p = os.path.join(work, "out", j["id"] + ".json")
            out[j["id"]] = json.load(open(p)) if os.path.exists(p) else {"error": "no trace (container: " + (r.stderr[-300:] or "?") + ")",
                                                                       "steps": [], "stdout": ""}
        retire_path(work)
        return out

    def cleanup(self):
        for d in self.staged:          # runner contexts and tracer copies: to ~/scratch, never deleted
            self.retire(d)
        self.staged = []
        if self.keep:
            return
        # Only images this run built; one another run built or still uses stays (a running
        # container keeps its image: rmi then fails and is ignored).
        for tag in sorted(self.mine):
            self.sh(["rmi", tag], check=False)


