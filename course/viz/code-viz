def all_blocks(root, page=None):
    out = []
    for p in pages(root, page):
        bs, _ = blocks(root, p)
        out += bs
    return out


def cmd_catalog(a):
    root = repo_root()
    info = site_info(root)
    bs = all_blocks(root, a.page)
    labeled = [b for b in bs if b["label"]]
    sugg = [(b, suggest(b)) for b in bs if not b["label"]]
    sugg = [(b, s) for b, s in sugg if s]
    counts = {}
    for b, s in sugg:
        counts[(s["viz"], s["lang"])] = counts.get((s["viz"], s["lang"]), 0) + 1
    langs = {}
    for b in bs:
        langs[b["lang"] or "none"] = langs.get(b["lang"] or "none", 0) + 1
    invalid = []
    for b in bs:
        if b["lang"] == "json":
            try:
                json.loads(b["code"])
            except ValueError as e:
                invalid.append(f"{b['page']}:{b['start'] + 1} json: {e}")
    print(f"{root}  ({info['course']}, site {info['url'] or '?'})")
    print(f"blocks: {len(bs)} (" + ", ".join(f"{k} {v}" for k, v in sorted(langs.items(), key=lambda x: -x[1])[:10]) + ")")
    print(f"labeled examples: {len(labeled)}")
    print("suggested labels: " + (", ".join(f"{v} {l} {n}" for (v, l), n in sorted(counts.items())) or "none"))
    if invalid:
        print(f"config blocks that do not parse: {len(invalid)}")
        for x in invalid[:10]:
            print("  " + x)
    os.makedirs(os.path.join(root, "viz"), exist_ok=True)
    json.dump({"labeled": [{"id": b["label"]["id"], "page": b["page"], "line": b["start"] + 1} for b in labeled],
               "suggested": [{"page": b["page"], "line": b["start"] + 1, **s} for b, s in sugg],
               "invalid_config": invalid}, open(os.path.join(root, "viz", "catalog.json"), "w"), indent=1)
    if a.verbose:
        for b, s in sugg:
            print(f"  {b['page']}:{b['start'] + 1}  {s['viz']} {s['lang']}")
    return 0


def link_line(info, vid):
