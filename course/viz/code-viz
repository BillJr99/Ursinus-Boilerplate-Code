EXT = {"python": "py", "scheme": "scm", "lambda": "lam", "c": "c", "cpp": "cpp", "haskell": "hs", "prolog": "pl",
       "ocaml": "ml", "mini": "mini", "shell": "sh"}
EXT.update(LX.EXT)


DATA_NAME = re.compile(r"""['"]([\w.-]+\.(?:txt|csv|tsv|json|dat|log))['"]""")
DATA_LANGS = {"", "text", "txt", "plain", "plaintext", "none", "csv", "tsv", "json", "output"}


def data_files(b, root, lookup=None):
    """Data files an example opens ("snacks.csv", "groceries.txt") that are not in the repo, taken
    from the page itself: a text block (``` or ```text, csv, json) that the prose just above it names
    ("Create a file called `poem.txt` ...", "Sample `numbers.txt`:", "Here's the file groceries.txt
    again:"), the nearest one above the example, else the nearest below. A file in the example's own
    folder or under files/ with that name wins over the page. Returns {name: text}."""
    if not b.get("page", "").endswith(".md"):
        return {}
    code = b["code"] + "\n" + ((b.get("label") or {}).get("setup_src") or "")
    lab = b.get("label") or {}
    ids = [x for x in (lab.get("setup") or "").split(",") if x]
    if ids:
        try:
            for sb in setup_chain(ids, lookup or block_lookup(root)):   # the whole chain, not just direct ids
                code += "\n" + sb["code"]
        except ValueError:
            pass
    names = sorted(set(DATA_NAME.findall(code)))
    if not names:
        return {}
    bs, lines = blocks(root, b["page"])
    out = {}
    for name in names:
        found = [os.path.join(dp, name) for dp, _, fn in os.walk(os.path.join(root, "files")) if name in fn]
        if len(found) == 1:
            out[name] = open(found[0], encoding="utf-8", errors="replace").read()
            continue
        cands = []
        for d in bs:
            if d["lang"] not in DATA_LANGS or d.get("html"):
                continue
            prose = "\n".join(lines[max(0, d["start"] - 4):d["start"]])
            if re.search(r"(?<![\w.-])" + re.escape(name) + r"(?![\w-])", prose):
                cands.append(d)
        if cands:
            above = [d for d in cands if d["start"] < b["start"]]
            pick = above[-1] if above else cands[0]
            out[name] = pick["code"].rstrip("\n") + "\n"
    return out


def job_for(b, root, src_dir, lookup=None):
    lab = b["label"]
    lang = LANG_ALIASES.get(lab.get("lang") or b["lang"], lab.get("lang") or b["lang"])
    viz = lab.get("viz", "plain")
    if viz == "lambda":
        lang = "lambda"
    fname = f"{lab['id']}/main.{EXT.get(lang, 'txt')}"
    os.makedirs(os.path.join(src_dir, lab["id"]), exist_ok=True)
    code = b["code"]
    if lang == "scheme":
        code = code + "\n"
    open(os.path.join(src_dir, fname), "w", encoding="utf-8").write(code)
    if lang == "python":
        # data files the program opens, written beside it from the page's own text blocks (section 4)
        for name, text in data_files(b, root, lookup).items():
            open(os.path.join(src_dir, lab["id"], name), "w", encoding="utf-8").write(text)
    # model calls on a CPU are slow: agent examples get five minutes unless the label says otherwise
    job = {"id": lab["id"], "viz": viz, "lang": lang, "file": fname, "timeout": int(lab.get("timeout", 300 if viz == "agent" else 20)),
           "max_steps": int(lab.get("max_steps", 800)), "page": b["page"], "line": b["start"] + 1}
    if lab.get("input"):
        job["input"] = lab["input"]
    if lab.get("args"):
        job["args"] = lab["args"]
    if lab.get("runner"):
        job["runner"] = lab["runner"]
    if lab.get("setup_src"):
        # a notebook cell: every earlier code cell runs first, like a setup= chain (section 4, Notebooks)
        sfile = f"{lab['id']}/setup.py"
        open(os.path.join(src_dir, sfile), "w", encoding="utf-8").write(lab["setup_src"] + "\n")
        job["setup"] = sfile
        job["setup_ids"] = [lab.get("setup_desc", "earlier notebook cells")]
    if lab.get("setup"):
        # setup=<id>[,<id>]: earlier blocks whose code runs first, untraced and silent (section 4)
        if lang != "python" and lang not in LX.SETUP_LANGS:
            raise ValueError(f"{lab['id']}: setup= works only for Python, SQL and VHDL blocks")
        chain = setup_chain([x for x in lab["setup"].split(",") if x], lookup or block_lookup(root))
        sfile = f"{lab['id']}/setup.{EXT.get(lang, 'txt')}"
        # SQL blocks may omit their last ";" (sqlite runs it anyway); add it so joined blocks stay separate
        open(os.path.join(src_dir, sfile), "w", encoding="utf-8").write("\n\n".join(
            x["code"] + (";" if lang == "sql" and not x["code"].rstrip().endswith(";") else "") for x in chain) + "\n")
        job["setup"] = sfile
        job["setup_ids"] = [x["label"]["id"] for x in chain]
    if lang == "mini" and lab.get("interp"):
        # interp=: run the Python interpreter the page builds, with this program as its input file
        ipage = interp_page(lab, b)
        files = interp_files(root, ipage)
        if not files:
            raise ValueError(f"{lab['id']}: interp={lab['interp']}: no `# name.py` Python blocks on {ipage}")
        idir = f"{lab['id']}/interp"
        os.makedirs(os.path.join(src_dir, idir), exist_ok=True)
        for f, code in files.items():
            open(os.path.join(src_dir, idir, f), "w", encoding="utf-8").write(code)
        job["interp_dir"] = idir
        job["interp_page"] = ipage
        job["interp_files"] = list(files)
        job["entry"] = lab.get("entry") or "runner.py --file {file}"
    elif lang == "mini":
        mini = os.path.join(root, "files/examples/mininote")
        if os.path.isdir(mini):
            shutil.copytree(mini, os.path.join(src_dir, "mini"), dirs_exist_ok=True)
    return job


def runner_for(job):
    # runner=NAME in a label picks a runner image by name (python-ml: PyTorch on CPU, section 2)
    if re.fullmatch(r"[A-Za-z0-9_-]+", job.get("runner") or "") and os.path.isdir(os.path.join(RUNNERS, job["runner"])):
        return job["runner"]
    return RUNNER_OF.get((job["viz"], job["lang"])) or PLAIN_RUNNER.get(job["lang"], "python")


def manifest_jobs(root, src_dir, man):
    jobs = []
    for e in man:
        p = os.path.join(root, e["file"])
        dst = os.path.join(src_dir, e["id"])
        if os.path.isdir(p):
            shutil.copytree(p, dst, dirs_exist_ok=True)
            fname = e["id"]
        else:
            os.makedirs(dst, exist_ok=True)
            shutil.copy(p, dst)
            fname = f"{e['id']}/{os.path.basename(p)}"
        lang = {"bison": "flexbison", "automaton": "dot"}.get(e["viz"], e.get("lang", "python"))
        jobs.append({"id": e["id"], "viz": e["viz"], "lang": lang, "file": fname, "input": e.get("input", ""),
                     "timeout": int(e.get("timeout", 60)), "page": e["file"], "line": 1})
    return jobs


def default_manifest(root, course):
    """Bison grammars (folders with a .y) and automata (.dot files) found under files/."""
    out = []
    for dp, dn, fn in os.walk(os.path.join(root, "files")):
        if "/." in dp or "node_modules" in dp:
            continue
        rel = os.path.relpath(dp, root)
        ys = [f for f in fn if f.endswith(".y")]
        if ys:
            inp = ""
            samples = os.path.join(dp, "samples.txt")
            if os.path.exists(samples):
                inp = next((l.strip() for l in open(samples, errors="replace") if l.strip() and not l.startswith("#")), "")
            out.append({"id": f"{course}-{slug(rel.replace('files/', '', 1).replace('/', '-'))}", "viz": "bison", "file": rel,
                        "input": inp or "2 * 3 + 4"})
        for f in fn:
            if f.endswith(".dot") and os.path.getsize(os.path.join(dp, f)) < 20000:
                txt = open(os.path.join(dp, f), errors="replace").read()
                if "doublecircle" in txt and "->" in txt:
                    out.append({"id": f"{course}-{slug(f)}", "viz": "automaton", "file": os.path.join(rel, f), "input": "abab"})
    return out + LX.manifest(root, course, slug)   # MIPS programs and VHDL designs (langs.py)


def run_jobs(jobs, docker, src_dir):
    by = {}
    for j in jobs:
        by.setdefault(runner_for(j), []).append(j)
    traces = {}
    for runner, js in sorted(by.items()):
        print(f"  {runner}: {len(js)} example(s)", flush=True)
        for i in range(0, len(js), 60):
            traces.update(docker.run_batch(runner, js[i:i + 60], src_dir))
    return traces


