def compact(t):
    """Shrink a trace for the site: each step keeps only the heap objects (Python) or frames and
    closures (Scheme) that changed since the step before, plus the list of ids still present; the
    viewer rebuilds the full state on load. Lossless."""
    steps = t.get("steps") or []
    if t.get("kind") != "env" or not steps:
        return t
    keys = ("heap",) if t.get("language") == "python" else ("frames", "closures")
    prev = {k: {} for k in keys}
    for s in steps:
        for k in keys:
            cur = s.get(k) or {}
            s[k + "_ids"] = list(cur.keys())
            s[k] = {i: o for i, o in cur.items() if prev[k].get(i) != o}
            prev[k] = cur
    t["compact"] = 1
    return t


def save_trace(path, t):
    """Traces are written gzipped (traces/<id>.json.gz); the viewer decompresses them. The gzip
    header carries no timestamp (mtime=0) and an unchanged trace is not rewritten, so a build
    (or build --check) whose examples did not change leaves git clean."""
    data = json.dumps(compact(t), separators=(",", ":"), sort_keys=True).encode()
    gz = path + ".gz"
    if os.path.exists(gz):
        try:
            with gzip.open(gz, "rb") as fh:
                if fh.read() == data:
                    return False
        except OSError:
            pass
    with open(gz, "wb") as raw, gzip.GzipFile(fileobj=raw, mode="wb", compresslevel=9, mtime=0) as fh:
        fh.write(data)
    if os.path.exists(path):
        retire_path(path)   # the old uncompressed trace goes to ~/scratch, not deleted
    return True


VOLATILE = [(re.compile(r"0x[0-9a-fA-F]+"), "0x#"),                     # addresses, handles
            (re.compile(r"\btmp[A-Za-z0-9_]{6,10}\b"), "tmp#"),             # tempfile names
            (re.compile(r"\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\b"), "Mon"),
            (re.compile(r"\b(Mon|Tue|Wed|Thu|Fri|Sat|Sun)\b"), "Day"),
            (re.compile(r"-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?"), "9")]          # every number


def trace_text(t, j):
    """A trace exactly as write_site would store it (for comparing a new run with the committed one)."""
    import copy
    t = copy.deepcopy(t)
    t.update({"id": j["id"], "page": j["page"], "line": j["line"], "viz": j["viz"], "lang": j["lang"]})
    t.setdefault("kind", j["viz"])
    return json.dumps(compact(t), separators=(",", ":"), sort_keys=True)


def shape(text):
    """A stored trace with what varies between runs (numbers, addresses, temp names, month and day
    names) replaced, so two runs that differ only there compare equal (section 6, Stable traces)."""
    for rx, rep_ in VOLATILE:
        text = rx.sub(rep_, text)
    return text


def stored_text(root, vid):
    p = os.path.join(root, "viz", "traces", vid + ".json.gz")
    try:
        with gzip.open(p, "rb") as fh:
            return fh.read().decode()
    except OSError:
        return None


def same_example(new, old):
    """Is a volatile example's new trace the committed one up to run-to-run values? Its code is the
    same (source, setup, interpreter), it fails or succeeds the same way, it drew as many figures,
    and its output is the same once numbers, addresses, temp names and dates are masked. The steps
    are not compared: in threaded or timing examples the objects alive at a step vary between runs."""
    for k in ("source", "setup", "interp", "language", "kind"):
        if new.get(k) != old.get(k):
            return False
    if bool(new.get("error")) != bool(old.get("error")) or len(new.get("figures") or []) != len(old.get("figures") or []):
        return False
    return shape(new.get("stdout") or "") == shape(old.get("stdout") or "")


def settle(root, jobs, traces, docker, src):
    """Keep the committed trace of an example whose output varies from run to run (section 6).

    For each example whose new trace differs from the committed one, run it once more. If the two new
    runs agree, the example is repeatable and the change is real: the new trace is written. If they
    disagree, the example is volatile (benchmark timings, thread scheduling, C stack addresses,
    library handles, ls dates, unseeded randomness in C); then, when its code is unchanged and its
    output differs only in what varies (same_example()), the committed trace is kept, so a build with
    nothing changed rewrites nothing. A volatile example whose code or output text changed is
    rewritten."""
    by = {j["id"]: j for j in jobs}
    differ = [vid for vid, j in by.items() if vid in traces and stored_text(root, vid) is not None
              and trace_text(traces[vid], j) != stored_text(root, vid)
              and not (traces[vid].get("error") and not traces[vid].get("steps") and not traces[vid].get("stdout"))]
    if not differ:
        return traces, []
    print(f"  {len(differ)} trace(s) differ from the committed ones; running them again to tell real changes from run-to-run noise")
    again = run_jobs([by[v] for v in differ], docker, src)
    vpath = os.path.join(root, "viz", "volatile.json")
    try:
        volatile = set(json.load(open(vpath)).get("volatile", []))
    except (OSError, ValueError):
        volatile = set()
    seen = set()
    # Two runs can agree by chance (both in the same minute). An example whose two runs agree but
    # whose trace differs from the committed one only in run-to-run values runs a third time.
    suspects = [v for v in differ if v not in volatile
                and trace_text(traces[v], by[v]) == trace_text(again.get(v, {}), by[v])
                and same_example(json.loads(trace_text(traces[v], by[v])), json.loads(stored_text(root, v)))]
    third = run_jobs([by[v] for v in suspects], docker, src) if suspects else {}
    kept = []
    for vid in differ:
        first, second = trace_text(traces[vid], by[vid]), trace_text(again.get(vid, {}), by[vid])
        if vid in third and trace_text(third[vid], by[vid]) != first:
            second = trace_text(third[vid], by[vid])
        old = stored_text(root, vid)
        if first != second:
            seen.add(vid)      # seen to vary between runs: remembered in viz/volatile.json
        if (first != second or vid in volatile) and same_example(json.loads(first), json.loads(old)):
            # keep the committed trace file; expected outputs are still checked against this run
            traces[vid] = dict(json.loads(old), _kept=True, _first_stdout=traces[vid].get("stdout") or "")
            kept.append(vid)
    if seen - volatile:
        # Two runs can agree by chance (both in the same minute), so an example once seen to vary
        # stays volatile; the list only grows, and an unchanged list is not rewritten.
        with open(vpath, "w") as f:
            json.dump({"volatile": sorted(volatile | seen)}, f, indent=1)
    return traces, kept


def norm(text):
    """Outputs compared without memory addresses, which change on every run."""
    return re.sub(r"0x[0-9a-fA-F]+", "0x?", text).rstrip()


def cmd_unlabel(a):
    """Remove examples: their label, their Visualize link, their trace and expected output."""
    root = repo_root()
    gone = set(a.ids)
    NB.unlabel(root, gone, site_info(root), pages(root), LINK_MARK)   # viz/notebooks.json and its page links
    for page in pages(root):
        bs, lines = blocks(root, page)
        hits = [b for b in bs if b["label"] and b["label"].get("id") in gone]
        for b in sorted(hits, key=lambda b: -b["start"]):
            after = link_slot(lines, b)
            vid = b["label"]["id"]
            if after < len(lines) and LINK_MARK in lines[after] and (f"#{vid})" in lines[after] or f'#{vid}"' in lines[after]):
                del lines[after]
            del lines[b["start"] - 1]
            print(f"{page}: unlabeled {b['label']['id']}")
        if hits:
            write_page(root, page, lines)
    site = os.path.join(root, "viz")
    for vid in gone:
        for p in (os.path.join(site, "traces", vid + ".json"), os.path.join(site, "traces", vid + ".json.gz"),
                  os.path.join(site, "expected", vid + ".out")):
            if os.path.exists(p):
                retire_path(p)   # moved to ~/scratch/code-viz, not deleted
    ip = os.path.join(site, "index.json")
    if os.path.exists(ip):
        d = json.load(open(ip))
        d["examples"] = [e for e in d.get("examples", []) if e["id"] not in gone]
        json.dump(d, open(ip, "w"), indent=1)
    return 0


def example_codes(root):
    """id -> code of every labeled example (page blocks and notebook cells), for tour checks."""
    return {b["label"]["id"]: b["code"] for b in all_blocks(root) if b.get("label") and b["label"].get("id")}


def example_meta(root, info):
    """id -> {viz, lang, page, line, page_url} of every labeled example, for publishing tours."""
    out = {}
    for b in all_blocks(root):
        lab = b.get("label") or {}
        if not lab.get("id"):
            continue
        page = b["page"]
        url = f"{info['url']}/{os.path.splitext(page.replace('_pages/', ''))[0]}" if page.startswith("_pages") else ""
        out[lab["id"]] = {"viz": lab.get("viz", "plain"), "lang": LANG_ALIASES.get(lab.get("lang") or b["lang"], lab.get("lang") or b["lang"]),
                          "page": page, "line": b["start"] + 1, "page_url": url}
    return out


def session_blocks(root):
    """[(id, title, page, code, label)] for shell blocks labeled viz=session (section 23)."""
    return [(b["label"]["id"], b["label"].get("title") or "", b["page"], b["code"], b["label"])
            for b in all_blocks(root) if b.get("label") and b["label"].get("viz") == "session" and b["label"].get("id")]


def cmd_tour(a):
    """code-viz tour check|draft (section 22)."""
    root = repo_root()
    codes = example_codes(root)
    if a.action == "check":
        tours = MD.load_tours(root, codes)
        wanted = set(a.ids)
        bad = 0
        for (vid, name), (t, errs) in sorted(tours.items(), key=lambda kv: (kv[0][0], kv[0][1] or "")):
            if wanted and vid not in wanted:
                continue
            tag = vid + (f"--{name}" if name else "")
            if errs:
                bad += 1
                print(f"{tag}: {len(errs)} problem(s)")
                for e in errs[:12]:
                    print(f"  {e}")
            elif a.verbose:
                print(f"{tag}: ok ({len(t['steps'])} steps{', reviewed' if t.get('reviewed') else ''})")
        print(f"{len(tours)} tour(s), {bad} with problems")
        return 1 if bad else 0
    return MD.cmd_draft(root, a, codes, all_blocks(root), site_info(root))


def cmd_session(a):
    """code-viz session check (section 23)."""
    root = repo_root()
    sessions = MD.session_sources(root, session_blocks(root))
    bad = 0
    for vid, doc in sorted(sessions.items()):
        if a.ids and vid not in a.ids:
            continue
        rec = MD.load_recording(root, vid)
        errs = MD.check_session(doc, rec)
        if rec is None:
            errs.append("not recorded yet (code-viz record " + vid + ")")
        if errs:
            bad += 1
            print(f"{vid}: " + "; ".join(errs[:6]))
        elif a.verbose:
            print(f"{vid}: ok ({len(rec.get('steps') or [])} steps, recorded {(rec.get('recorded') or {}).get('at', '?')})")
    print(f"{len(sessions)} session(s), {bad} with problems")
    return 1 if bad else 0


def write_site(root, info, traces, jobs, a):
    site = os.path.join(root, "viz")
    os.makedirs(os.path.join(site, "traces"), exist_ok=True)
    os.makedirs(os.path.join(site, "expected"), exist_ok=True)
    os.makedirs(os.path.join(site, "tracers"), exist_ok=True)
    for f in os.listdir(VIEWER):
        shutil.copy(os.path.join(VIEWER, f), site)
    for f in ("pytrace.py", "schemetrace.py", "lambdatrace.py", "automaton.py") + LX.BROWSER_TRACERS:
        shutil.copy(os.path.join(TRACERS, f), os.path.join(site, "tracers"))
    index_path = os.path.join(site, "index.json")
    index = {e["id"]: e for e in (json.load(open(index_path)).get("examples", []) if os.path.exists(index_path) else [])}
    changed, failed = [], []
    for j in jobs:
        t = traces.get(j["id"], {})
        t.update({"id": j["id"], "page": j["page"], "line": j["line"], "viz": j["viz"], "lang": j["lang"]})
        t.setdefault("kind", j["viz"])
        if t.get("error") and not t.get("steps") and not t.get("stdout"):
            failed.append((j["id"], t["error"]))
        first_out = t.pop("_first_stdout", None)
        if not t.pop("_kept", False):   # settle() kept the committed trace: leave its file untouched
            save_trace(os.path.join(site, "traces", j["id"] + ".json"), t)
        exp = os.path.join(site, "expected", j["id"] + ".out")
        out = t.get("stdout") or "" if first_out is None else first_out   # expected: this run's output
        if os.path.exists(exp) and not a.update_expected:
            if norm(open(exp, errors="replace").read()) != norm(out) and j["viz"] != "agent":
                changed.append(j["id"])
        else:
            open(exp, "w").write(out)
        page_url = f"{info['url']}/{os.path.splitext(j['page'].replace('_pages/', ''))[0]}" if j["page"].startswith("_pages") else ""
        index[j["id"]] = {"id": j["id"], "viz": j["viz"], "lang": j["lang"], "page": j["page"], "line": j["line"],
                          "page_url": page_url, "error": t.get("error"), "steps": len(t.get("steps") or [])}
    examples = list(index.values())
    # Explain and Simulate modes (sections 21 to 23): publish valid tours, keep recordings, and list
    # each example's modes. A repo with no codeviz/ sources and no sessions is left exactly as before.
    problems, _ = MD.publish(root, example_codes(root), session_blocks(root), examples, example_meta(root, info))
    for p in problems[:40]:
        print(f"  {p}")
    examples = sorted(examples, key=lambda e: (e["page"], e["line"]))
    old = json.load(open(index_path)) if os.path.exists(index_path) else {}
    # Keep the old build time (and the file untouched) when no example changed.
    if old.get("examples") != examples or old.get("site") != info["url"]:
        json.dump({"course": info["course"], "site": info["url"], "built": time.strftime("%Y-%m-%d %H:%M"),
                   "examples": examples}, open(index_path, "w"), indent=1)
    return changed, failed


def collect(root, info, a, src):
    jobs = []
    for b in all_blocks(root, a.page):
        lab = b["label"]
        if not lab:
            continue
        if a.lang and (lab.get("lang") or b["lang"]) != a.lang:
            continue
        if getattr(a, "manifest_only", False):
            break
        if lab.get("viz") == "agent" and not getattr(a, "record_agents", False):
            continue  # recorded on minipc, committed, replayed
        if lab.get("viz") in ("session", "show"):
            continue  # session: recorded by `code-viz record`; show: display only (Explain mode), never run
        jobs.append(job_for(b, root, src))
    if getattr(a, "manifest_only", False):
        jobs = []
    if not a.page and not a.lang:
        mpath = os.path.join(root, "viz", "manifest.json")
        man = json.load(open(mpath)) if os.path.exists(mpath) else default_manifest(root, info["course"])
        if man or os.path.exists(mpath):
            # A repo with no grammars or automata gets no viz/manifest.json (and so no viz/ at all).
            os.makedirs(os.path.dirname(mpath), exist_ok=True)
            json.dump(man, open(mpath, "w"), indent=1)
        jobs += manifest_jobs(root, src, man)
    return jobs


def cmd_build(a):
    root = repo_root()
    info = site_info(root)
    src = tempfile.mkdtemp(prefix="code-viz-build-")
    jobs = collect(root, info, a, src)
    if not jobs and not os.path.exists(os.path.join(root, "viz", "index.json")):
        # No labeled examples and no site yet (a course that has not started using code-viz):
        # write nothing, so CI leaves the repo exactly as it was.
        retire_path(src)
        print(f"no code-viz examples in {info['course']}; nothing written")
        return 0
    print(f"building {len(jobs)} example(s) for {info['course']}")
    docker = Docker(a.host, keep=a.keep_images, ollama_network=a.ollama_network)
    kept = []
    try:
        traces = run_jobs(jobs, docker, src)
        if not getattr(a, "no_settle", False):
            traces, kept = settle(root, jobs, traces, docker, src)   # stable traces (section 6)
    finally:
        docker.cleanup()
        retire_path(src)
    changed, failed = write_site(root, info, traces, jobs, a)
    print(f"wrote {len(jobs)} trace(s) to viz/; failed {len(failed)}; output changed {len(changed)}"
          + (f"; kept {len(kept)} committed trace(s) that differ only in run-to-run values" if kept else ""))
    for vid, err in failed[:40]:
        print(f"  failed {vid}: {str(err)[:140]}")
    for vid in changed[:40]:
        print(f"  changed {vid}")
    # --check fails when an example stopped running; --strict also when an output changed
    # (examples that use randomness or the clock change their output legitimately).
    return 1 if (a.check and failed) or (a.strict and (changed or failed)) else 0


def single_job(a, root, info, src):
    target = a.target
    if os.path.exists(target):
        p = os.path.abspath(target)
        ext = os.path.splitext(p)[1].lstrip(".")
        viz = a.viz or LX.FILE_VIZ.get(ext) or ("automaton" if ext == "dot" else "bison" if os.path.isdir(p) or ext == "y" else
                        "env" if ext in ("py", "scm", "rkt") else "c" if ext in ("c", "cpp") else "lambda" if ext == "lam" else "plain")
        e = {"id": a.id or ("file-" + slug(p)), "viz": viz, "file": os.path.relpath(p, root) if p.startswith(root) else p,
             "input": a.input or ""}
        if os.path.isabs(e["file"]):
            dst = os.path.join(src, e["id"])
            if os.path.isdir(p):
                shutil.copytree(p, dst, dirs_exist_ok=True)
                fname = e["id"]
            else:
                os.makedirs(dst, exist_ok=True)
                shutil.copy(p, dst)
                fname = f"{e['id']}/{os.path.basename(p)}"
            lang = {"py": "python", "scm": "scheme", "rkt": "scheme", "c": "c", "cpp": "cpp", "lam": "lambda", "hs": "haskell",
                    "pl": "prolog", "ml": "ocaml", "sh": "shell", **LX.FILE_LANG}.get(ext, "flexbison" if viz == "bison" else "dot" if viz == "automaton" else "python")
            return {"id": e["id"], "viz": viz, "lang": lang, "file": fname, "input": e["input"], "timeout": 60,
                    "max_steps": 800, "page": p, "line": 1}
        if viz in ("bison", "automaton"):
            return manifest_jobs(root, src, [e])[0]
        b = {"label": {"id": e["id"], "viz": viz}, "lang": LANG_ALIASES.get(ext, ext), "code": open(p).read(), "page": e["file"], "start": 0}
        return job_for(b, root, src)
    for b in all_blocks(root):
        if b["label"] and b["label"].get("id") == target:
            return job_for(b, root, src)
    mpath = os.path.join(root, "viz", "manifest.json")
    for e in (json.load(open(mpath)) if os.path.exists(mpath) else default_manifest(root, info["course"])):
        if e["id"] == target:
            if a.input:
                e["input"] = a.input
            return manifest_jobs(root, src, [e])[0]
    raise SystemExit(f"no example or file named {target}")


def cmd_run(a):
    root = repo_root()
    info = site_info(root)
    src = tempfile.mkdtemp(prefix="code-viz-run-")
    job = single_job(a, root, info, src)
    docker = Docker(a.host, keep=a.keep_images, ollama_network=a.ollama_network)
    try:
        traces = run_jobs([job], docker, src)
    finally:
        docker.cleanup()
    t = traces[job["id"]]
    if os.path.isabs(job.get("page", "")) and not job["page"].startswith(root + os.sep):  # a file outside the site
        json.dump(t, sys.stdout)
        print()
    else:
        write_site(root, info, traces, [job], argparse.Namespace(update_expected=False))
        print(f"{job['id']}: {len(t.get('steps') or [])} step(s), error: {t.get('error')}")
        print(f"output:\n{(t.get('stdout') or '')[:2000]}")
        print(f"view: {info['url']}/viz/#{job['id']}  (or code-viz serve {job['id']})")
    return 0


def cmd_serve(a):
    root = repo_root()
    info = site_info(root)
    site = os.path.join(root, "viz")
    os.makedirs(site, exist_ok=True)
    for f in os.listdir(VIEWER):
        shutil.copy(os.path.join(VIEWER, f), site)
    os.makedirs(os.path.join(site, "tracers"), exist_ok=True)
    for f in ("pytrace.py", "schemetrace.py", "lambdatrace.py", "automaton.py") + LX.BROWSER_TRACERS:
        shutil.copy(os.path.join(TRACERS, f), os.path.join(site, "tracers"))
    first = ""
    if a.target:
        cmd_run(argparse.Namespace(**{**vars(a), "id": None, "viz": None, "input": a.input}))
        first = a.target if not os.path.exists(a.target) else "file-" + slug(os.path.abspath(a.target))
    docker = Docker(a.host, keep=True, ollama_network=a.ollama_network)

    class H(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *x, **k):
            super().__init__(*x, directory=root, **k)

        def do_POST(self):
            if self.path != "/viz/api/run":
                self.send_error(404)
                return
            body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
            src = tempfile.mkdtemp(prefix="code-viz-live-")
            b = {"label": {"id": "live", "viz": body.get("viz", "env"), "lang": body.get("lang"), "input": body.get("input"),
                           "setup": ",".join(body.get("setup") or [])},
                 "lang": body.get("lang", "python"), "code": body.get("code", ""), "page": "live", "start": 0}
            job = job_for(b, root, src)
            try:
                t = run_jobs([job], docker, src)[job["id"]]
            except Exception as e:
                t = {"error": str(e), "steps": [], "stdout": ""}
            data = json.dumps(t).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

    print(f"serving {root} at http://localhost:{a.port}/viz/" + (f"#{first}" if first else "") + "  (Ctrl+C stops)")
    try:
        http.server.ThreadingHTTPServer(("0.0.0.0" if a.public else "127.0.0.1", a.port), H).serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        docker.keep = a.keep_images
        docker.cleanup()
    return 0


def student_url(info, vid):
    """The student-mode link for an example: <site>/viz/?student=1#<id>."""
    return f"{info['url']}/viz/?student=1#{vid}"


def qr_image_url(info, root, out, vid):
    """The site address of <out>/<vid>.svg, or None when out is not served by the site (outside the
    repo, or in a folder Jekyll skips: names starting with _ or ., except _pages, which is served
    without its _pages/ prefix)."""
    rel = os.path.relpath(out, root).replace(os.sep, "/")
    if rel == ".":
        rel = ""
    if rel.startswith(".."):
        return None
    if rel == "_pages" or rel.startswith("_pages/"):
        rel = rel[len("_pages"):].lstrip("/")
    if any(part.startswith(("_", ".")) for part in rel.split("/") if part):
        return None
    return f"{info['url']}/{rel + '/' if rel else ''}{vid}.svg"


def cmd_qr(a):
    """QR codes for students: each id gets viz/qr/<id>.svg and .png (or --out DIR), made in a
    throwaway "qr" runner container (segno, no network). --print only prints the links;
    --snippet also prints a Markdown block for a deck or page (image plus link)."""
    root = repo_root()
    info = site_info(root)
    if not info["url"]:
        print("no url in _config.yml; cannot make student links", file=sys.stderr)
        return 2
    known = {b["label"]["id"] for b in all_blocks(root) if b.get("label")}
    idx = os.path.join(root, "viz", "index.json")
    if os.path.exists(idx):
        known |= {e["id"] for e in json.load(open(idx)).get("examples", [])}
    bad = [i for i in a.ids if i not in known]
    if bad and not a.force:
        print("unknown example id(s): " + ", ".join(bad) + " (code-viz catalog lists them; --force skips this check)", file=sys.stderr)
        return 2
    urls = {i: student_url(info, i) for i in a.ids}
    if a.print_only:
        for i, u in urls.items():
            print(f"{i}  {u}")
        return 0
    out = os.path.abspath(a.out or os.path.join(root, "viz", "qr"))
    os.makedirs(out, exist_ok=True)
    work = tempfile.mkdtemp(prefix="code-viz-qr-")
    json.dump(urls, open(os.path.join(work, "urls.json"), "w"))
    docker = Docker(a.host, keep=a.keep_images)
    try:
        tag = docker.image("qr")
        rwork = docker.remote_dir(work, f"qr-{int(time.time())}-{os.getpid()}")
        script = ("import json, segno\n"
                  "for i, u in json.load(open('/out/urls.json')).items():\n"
                  "    q = segno.make(u, error='m')\n"
                  f"    q.save('/out/' + i + '.svg', scale={a.scale}, border=2)\n"
                  f"    q.save('/out/' + i + '.png', scale={a.scale}, border=2)\n")
        docker.sh(["run", "--rm", "--network", "none", "--cpus", "1", "--memory", "256m",
                   "-v", f"{rwork}:/out", tag, "python3", "-c", script], timeout=600)
        docker.fetch_dir(rwork, work)
        docker.retire(rwork)
    finally:
        docker.cleanup()
    for i, u in urls.items():
        for ext in ("svg", "png"):
            src = os.path.join(work, f"{i}.{ext}")
            if os.path.exists(src):
                shutil.copy(src, os.path.join(out, f"{i}.{ext}"))
        print(f"{i}  {u}  ->  {os.path.relpath(os.path.join(out, i + '.svg'), root)} (.png too)")
        if a.snippet:
            img = qr_image_url(info, root, out, i)
            if img is None:
                print(f"  note: {out} is not served by the course site (outside the repo, or a folder starting "
                      f"with _ or .); copy {i}.svg into a served folder (viz/qr/ is the default)", file=sys.stderr)
                img = os.path.join(out, i + ".svg")
            print(f"\n<!-- code-viz QR for {i} -->\n![Scan to open this example on your phone]({img})\n"
                  f"[Open this example]({u})\n")
    retire_path(work)
    return 0


README_NOTE = "<!-- Generated from the header of code-viz by `code-viz readme --write`. Edit the header, not this file. -->\n\n"


def cmd_readme(a):
    """Print the manual, or write or check README.md (section 5, readme)."""
    text = README_NOTE + __doc__
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "README.md")
    if a.check:
        same = os.path.exists(path) and open(path, encoding="utf-8").read() == text
        print("README.md matches the header" if same else "README.md differs: run code-viz readme --write")
        return 0 if same else 1
    if a.write:
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
        print(f"wrote {path}")
        return 0
    sys.stdout.write(__doc__)
    return 0


def main():
    ap = argparse.ArgumentParser(
        prog="code-viz", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Run a course site's code examples in throwaway containers and step through them in a\n"
                    "static viewer (teacher view <site>/viz/#<id>, student mode <site>/viz/?student=1#<id>).",
        epilog="The full manual is this file's header: `code-viz readme` prints it (also README.md).")
    ap.add_argument("--host", help="run containers on this machine over SSH (user@host); default CODE_VIZ_HOST or local Docker")
    ap.add_argument("--keep-images", action="store_true", help="keep runner images after the run")
    sub = ap.add_subparsers(dest="cmd", required=True)
