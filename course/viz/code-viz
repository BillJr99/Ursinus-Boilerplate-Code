def site_info(root):
    url, base = "", ""
    cfg = os.path.join(root, "_config.yml")
    if os.path.exists(cfg):
        for line in open(cfg, encoding="utf-8", errors="replace"):
            m = re.match(r"^\s*url\s*:\s*\"?([^\"#\s]+)", line)
            if m:
                url = m.group(1).rstrip("/")
            m = re.match(r"^\s*baseurl\s*:\s*\"?([^\"#\s]*)", line)
            if m:
                base = m.group(1).rstrip("/")
    # The site lives at <url>/<repo name> on GitHub Pages. A parent repo's _config.yml often still has
    # the baseurl of the term it was copied from (Ursinus-CS170 says /Ursinus-CS170-Fall2024), so the
    # repo name from the git remote wins when there is one; links then open this repo's own viz/.
    try:
        origin = subprocess.run(["git", "-C", root, "remote", "get-url", "origin"], capture_output=True,
                                text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        origin = ""
    m = re.search(r"github\.com[:/][^/]+/([^/]+?)(?:\.git)?$", origin)
    if m and url.lower().endswith("github.io"):
        base = "/" + m.group(1)
    name = os.path.basename(root)
    m = re.search(r"(CS\d+|CIE\d+)", name, re.I)
    course = m.group(1).lower() if m else re.sub(r"\W", "", re.sub(r"^ursinus-", "", name.lower()))[:12]
    # GitHub Pages paths are case-sensitive: lower-case only the host
    return {"url": (url.lower() + base) if url else "", "course": course}


def retire_path(path):
    """Move a file or folder code-viz is done with to ~/scratch/code-viz/ instead of deleting it
    (Bill, 2026-11-14: "rm should ask too ... you can always move to scratch"). Section 15."""
    if not os.path.lexists(path):
        return
    dest = os.path.join(os.path.expanduser("~"), "scratch", "code-viz")
    os.makedirs(dest, exist_ok=True)
    target = os.path.join(dest, f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}-{os.path.basename(path.rstrip('/'))}")
    n = 1
    while os.path.lexists(target):
        n += 1
        target = target.rsplit("~", 1)[0] + f"~{n}"
    try:
        shutil.move(path, target)
    except OSError:
        pass


